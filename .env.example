# Neon Postgres connection string (use the pooled URL for DATABASE_URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Direct/unpooled Neon URL, used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Generate a strong random value, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Local URL; on Vercel set this to your public deployment URL
NEXTAUTH_URL="http://localhost:3000"
